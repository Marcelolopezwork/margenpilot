# Margen Pilot — variables de entorno
# Copia este archivo a .env y rellena los valores desde tu panel de Supabase:
#   Project Settings → API
# .env está en .gitignore y NUNCA se sube al repositorio.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# La clave service_role NO va en este archivo ni en ningún otro del repo.
# Solo vive en los secretos de CI y dentro de Edge Functions.
# Si alguna vez aparece aquí, hay que rotarla en Supabase.
